# Local development
DISABLE_AUTH=true
CHESSMIMIC_MODELS_PATH=models
CHESSMIMIC_FORCE_CPU=true
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Clerk authentication. Required when DISABLE_AUTH is not true.
# CLERK_ISSUER_URL=https://your-instance.clerk.accounts.dev
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_FRONTEND_URL=http://localhost:3000
# CLERK_ALLOWED_AUTHORIZED_PARTIES=http://localhost:3000

# Supabase rating persistence. Required for rating endpoints.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_KEY=your-supabase-anon-key

# Optional backend Sentry monitoring. Disabled when SENTRY_DSN is unset.
# SENTRY_DSN=
SENTRY_SEND_DEFAULT_PII=false
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_PROFILES_SAMPLE_RATE=0
