# Backend API
NEXT_PUBLIC_API_URL=http://localhost:8000

# Local development without Clerk. Set the backend DISABLE_AUTH=true as well.
NEXT_PUBLIC_DISABLE_AUTH=true

# Clerk authentication. Required when NEXT_PUBLIC_DISABLE_AUTH is not true.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=your_clerk_secret_key
# NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
# NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# Optional Sentry monitoring. Disabled when NEXT_PUBLIC_SENTRY_DSN is unset or
# NEXT_PUBLIC_DISABLE_SENTRY=true.
NEXT_PUBLIC_DISABLE_SENTRY=true
# NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_SEND_DEFAULT_PII=false
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0

# Optional PostHog analytics. Disabled when NEXT_PUBLIC_POSTHOG_KEY is unset.
# NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
